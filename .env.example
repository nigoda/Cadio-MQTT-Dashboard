# ==============================================================================
# NIVIXSA DASHBOARD CONFIGURATION
# Copy this to .env and fill in your real credentials.
# ==============================================================================

# --- AI SCHEDULING (REQUIRED) ---
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyD...your_key_here...

# --- ADMINISTRATIVE ACCESS (REQUIRED) ---
# This identity is used to log in at http://localhost:5000/admin/login
ADMIN_EMAIL=admin@nivixsa.com
ADMIN_PASSWORD=nivixsa-admin-2024

# --- LEGACY / DEFAULT LOGIN (OPTIONAL) ---
# If these are set, the server will auto-connect this user on startup
MQTT_USERNAME=your@email.com
MQTT_PASSWORD=your_nivixsa_password

# --- STRIPE BILLING (PHASE 3 - COMING SOON) ---
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- SERVER SETTINGS ---
