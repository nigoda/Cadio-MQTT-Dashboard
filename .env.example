# ==============================================================================
# NIVIXSA DASHBOARD CONFIGURATION
# Copy this to .env and fill in your real credentials.
# ==============================================================================

# --- AI SCHEDULING (OPTIONAL) ---
# Enables the AI Agronomist weather-based irrigation scheduling.
# Without this, manual schedules still work fine.
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyD...your_key_here...

# --- ADMINISTRATIVE ACCESS ---
# Used to log in at http://localhost:5000/admin/login
ADMIN_EMAIL=admin@nivixsa.com
ADMIN_PASSWORD=nivixsa-admin-2024

# --- LEGACY / DEFAULT LOGIN (OPTIONAL) ---
# If set, the server will auto-connect this user on startup.
# Otherwise, users enter credentials on the login screen.
MQTT_USERNAME=your@email.com
MQTT_PASSWORD=your_nivixsa_password

# --- VAPID WEB PUSH KEYS (OPTIONAL) ---
# Enables native lock-screen push notifications on iOS/Android/Desktop.
# Without these, the app works fully — only background push is disabled.
# In-app toast notifications always work regardless of these keys.
#
# To DISABLE push notifications: comment out or delete the 3 lines below.
# To RE-ENABLE: uncomment them and restart the server.
#
# Key Format:
#   PUBLIC_KEY  → exactly 87 characters, URL-safe Base64, starts with 'B'
#   PRIVATE_KEY → exactly 43 characters, URL-safe Base64
#   CLAIMS_EMAIL → must start with 'mailto:' followed by any valid email
#
# ⚠️ Public + Private keys are a MATCHED PAIR — generate them together.
#    Changing keys invalidates all existing subscriptions.
#    (Users auto-resubscribe on next login — no manual action needed.)
#
# Generate new keys:
#   python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('Public:', v.public_key); print('Private:', v.private_key)"
#
VAPID_PUBLIC_KEY=your_87_char_public_key_here
VAPID_PRIVATE_KEY=your_43_char_private_key_here
VAPID_CLAIMS_EMAIL=mailto:your@email.com

# --- SERVER SETTINGS (OPTIONAL) ---
# MQTT_BROKER=egycad.com
# MQTT_PORT=1883
# PORT=5000
# DEBUG=False
